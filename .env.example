# Скопируй в .env и подставь креды тестовой среды. .env в git НЕ коммитится.
# URL — несекретные (есть дефолты в lib/config.js).
LIMITS_BASE_URL=https://payments.example.com
LIMITS_CORE_URL=https://console.example.com
LIMITS_ADMIN_URL=https://admin.example.com
LIMITS_TENANT_B_URL=https://payments-b.example.com
LIMITS_TENANT_C_URL=https://payments-c.example.com

# Keycloak SSO (админка + консоль)
LIMITS_KC_USER=<sso_user>
LIMITS_KC_PASS=<sso_pass>
# Второй оператор для maker-checker (опционально)
LIMITS_KC_OP2_USER=<sso_user_2>
LIMITS_KC_OP2_PASS=<sso_pass_2>

# Мерчи/шопы (payin/payout, HMAC bearer + api secret)
LIMITS_PAYIN_BEARER=<bearer>
LIMITS_PAYIN_SECRET=<api_secret>
LIMITS_PAYOUT_BEARER=<bearer>
LIMITS_PAYOUT_SECRET=<api_secret>
LIMITS_SHOP_A_BEARER=<bearer>
LIMITS_SHOP_A_SECRET=<api_secret>
LIMITS_SHOP_B_BEARER=<bearer>
LIMITS_SHOP_B_SECRET=<api_secret>

# Мультитенант (USD) — валюта / изоляция тенантов
LIMITS_TENANT_B_BEARER=<bearer>
LIMITS_TENANT_B_SECRET=<api_secret>
LIMITS_TENANT_C_BEARER=<bearer>
LIMITS_TENANT_C_SECRET=<api_secret>

# webhook.site токен для проверки callback'ов
LIMITS_WEBHOOK_TOKEN=<webhook_site_token>
